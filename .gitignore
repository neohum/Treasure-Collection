node_modules/
.env
.env.local
.DS_Store
# dist/ (Cloud-School 배포용 번들 산출물 보존)
# dist/
build/
*.log
*.zip

# autonomous-loop local state (created at runtime, never committed)
# cooldown.json holds per-agent rate-limit reset times; lock files coordinate
# task claims; shots/ + reject/ are mobile-approval artifacts.
.harness/
current_tasks/*.lock
current.md

# Agent local configs & shared skills
/.agents/*
!/.agents/skills/
# 행동 스펙은 프로젝트가 소유하고 리뷰하는 계약이다 — 무시하면 배포되지 않는다.
!/.agents/behaviors/

# local runtime logs & test artifacts
logs/
*.bundle
**/test-results/
**/playwright-report/

# 교사가 실제로 쓰는 핵심어 평문. 번들에는 해시만 들어가고 평문은 저장소에 올리지 않는다.
content/keywords.json
# build:config가 생성한다 (src/data + content/keywords.json → public/config.json)
public/config.json

# 서브에이전트 격리 워크트리 (git add -A에 딸려 들어가면 안 된다)
.claude/worktrees/
